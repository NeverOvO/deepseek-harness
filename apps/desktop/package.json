{
  "name": "@yunyulai/yanami-workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/main.js",
  "description": "Yanami Workbench desktop shell over the DeepSeek Harness runtime",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "pnpm run build && electron .",
    "package": "electron-forge package",
    "make:mac": "electron-forge make --platform=darwin"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "electron": "43.2.0"
  }
}
